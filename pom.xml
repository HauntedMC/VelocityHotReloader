<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.platform</groupId>
        <artifactId>haunted-application-parent</artifactId>
        <version>2.0.0</version>
        <relativePath/>
    </parent>
    <groupId>nl.hauntedmc.velocityhotreloader</groupId>
    <artifactId>velocityhotreloader</artifactId>
    <version>${revision}</version>
    <name>VelocityHotReloader</name>
    <description>Hot-load, unload, reload, and watch Velocity plugins.</description>
    <url>https://github.com/HauntedMC/VelocityHotReloader</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>HauntedMC</name>
        <url>https://www.hauntedmc.nl</url>
    </organization>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>HauntedMC</id>
            <name>HauntedMC</name>
            <url>https://www.hauntedmc.nl</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/HauntedMC/VelocityHotReloader.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/HauntedMC/VelocityHotReloader.git</developerConnection>
        <url>https://github.com/HauntedMC/VelocityHotReloader</url>
        <tag>v1.2.6</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/HauntedMC/VelocityHotReloader/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/HauntedMC/VelocityHotReloader/actions</url>
    </ciManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - VelocityHotReloader</name>
            <url>https://maven.pkg.github.com/HauntedMC/VelocityHotReloader</url>
        </repository>
    </distributionManagement>
    <properties>
        <revision>1.2.6</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-09-25T00:00:00Z</project.build.outputTimestamp>
        <night-config.version>3.9.0</night-config.version>
    </properties>
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <version>1.0.500</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.electronwill.night-config</groupId>
            <artifactId>toml</artifactId>
            <version>${night-config.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>net.kyori</groupId>
                    <artifactId>adventure-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${haunted.mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>5.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>VelocityHotReloader-${project.version}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>nl.hauntedmc.velocityhotreloader.velocity.dependencies.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.kyori.adventure.text.minimessage</pattern>
                                    <shadedPattern>nl.hauntedmc.velocityhotreloader.velocity.dependencies.adventure.text.minimessage</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.velocitypowered</groupId>
                            <artifactId>velocity-api</artifactId>
                            <version>${haunted.velocity.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>platform-acceptance</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>acceptance-classpath</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>build-classpath</goal>
                                </goals>
                                <configuration>
                                    <includeScope>test</includeScope>
                                    <outputFile>${project.build.directory}/acceptance-classpath.txt</outputFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-platform-acceptance</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>src/acceptance/run-acceptance.sh</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <VHR_ARTIFACT>${project.build.directory}/${project.build.finalName}.jar</VHR_ARTIFACT>
                                        <VHR_VELOCITY_API_CLASSPATH>${project.build.directory}/acceptance-classpath.txt</VHR_VELOCITY_API_CLASSPATH>
                                        <VHR_RUNTIME_VERSION>${haunted.velocity.version}</VHR_RUNTIME_VERSION>
                                        <VHR_RUNTIME_BUILD>${haunted.velocity.runtime.build}</VHR_RUNTIME_BUILD>
                                        <VHR_RUNTIME_SHA256>${haunted.velocity.runtime.sha256}</VHR_RUNTIME_SHA256>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
